<?xml version="1.0"?>
<package format="3">
  <name>robe_stretch</name>
  <version>0.1.0</version>
  <description>Stretch 3 BedPull executor: localize, linear pull, contact grasp.</description>
  <maintainer email="rchi-lab@example.com">RoBE maintainers</maintainer>
  <license>MIT</license>
  <depend>rclpy</depend>
  <depend>control_msgs</depend>
  <depend>trajectory_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>std_srvs</depend>
  <depend>std_msgs</depend>
  <depend>tf2_ros</depend>
  <depend>cv_bridge</depend>
  <depend>robe_stretch_interfaces</depend>
  <!-- Optional Stretch-side helper; workstation uses the fallback qpos map. -->
  <exec_depend>hello_helpers</exec_depend>
  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
